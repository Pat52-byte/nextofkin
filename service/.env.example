# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Shared secret that Zapier sends in the X-Api-Key header
SERVICE_API_KEY=

# Key that turns people's details into stable codes before the AI sees them
PSEUDONYM_KEY=

# Postgres connection string (Neon)
DATABASE_URL=
